# Supabase project URL (Project Settings → API → Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key (Project Settings → API → service_role). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: change the storage table name (defaults to app_data)
# SUPABASE_TABLE=app_data

# Port (Render sets this automatically)
PORT=8080
